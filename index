/* =========================
   TOOLTIP
========================= */
function handleHover({ object, x, y, layer }) {
  const tip = document.getElementById("tooltip");
  if (!object) {
    tip.style.display = "none";
    return;
  }
  const p = object.properties || object;
  if (!p) { tip.style.display = "none"; return; }

  let html = "";

  if (p.DT_score !== undefined) {
    const attrLabel =
      currentAttr === "IVS" ? "Verde & Sombra (IVS)" :
      currentAttr === "IEC" ? "Exposição ao Calor (IEC)" :
      currentAttr === "IPE" ? "Pressão Energética (IPE)" :
      "Índice Composto";
    const val = currentAttr === "IVS" ? (1 - p.IVS) :
                currentAttr === "IEC" ? p.IEC :
                currentAttr === "IPE" ? p.IPE : p.DT_score;
    const level = val > 0.8 ? 5 : val > 0.6 ? 4 : val > 0.4 ? 3 : val > 0.2 ? 2 : 1;
    html = `<b>${attrLabel}</b><br>Valor: ${val.toFixed(3)}<br>Nível: ${level}/5`;
  } else if (p.nome) {
    html = `<b>${p.nome}</b>`;
    if (p.comercio_m2) {
      html += `<br>🏬 Comércio: ${p.comercio_m2.toLocaleString()} m²`;
      html += `<br>🏢 Escritórios: ${p.escritorios_m2.toLocaleString()} m²`;
      html += `<br>🏠 Habitação: ${p.apartamentos} fogos`;
    }
  } else if (p.building) {
    html = `<b>Edificado</b><br>Tipo: ${p.building}`;
    if (p["building:levels"]) html += `<br>Pisos: ${p["building:levels"]}`;
  }

  if (html) {
    tip.innerHTML = html;
    tip.style.left = (x + 12) + "px";
    tip.style.top  = (y + 12) + "px";
    tip.style.display = "block";
  } else {
    tip.style.display = "none";
  }
}

function handleClick({ object }) {
  if (!object) return;
  const p = object.properties || object;
