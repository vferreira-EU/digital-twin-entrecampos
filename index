function buildBasemapLayer() {
  const url = BASEMAPS[currentBasemap];
  return new TileLayer({
    id: "basemap",
    data: url,
    minZoom: 0, maxZoom: 19,
    tileSize: 256,
    renderSubLayers: props => {
      const { boundingBox } = props.tile;
      return new BitmapLayer(props, {
        data: null,
        image: props.data,
        bounds: [boundingBox[0][0], boundingBox[0][1], boundingBox[1][0], boundingBox[1][1]]
      });
    }
  });
}

function buildDTLayer() {
  if (currentAttr === "none") return null;
  return new GeoJsonLayer({
    id: "dt-grid",
    data: DT_DATA,
    pickable: true,
    stroked: false,
    filled: true,
    extruded: true,
    wireframe: false,
    getFillColor: f => {
      const v = scaleValue(currentAttr, f);
      return colorFromValue(v);
    },
    getElevation: f => {
      const v = scaleValue(currentAttr, f);
      return heightFromValue(v);
    },
    material: {
      ambient: 0.4,
      diffuse: 0.6,
      shininess: 20,
      specularColor: [80, 80, 80]
    },
    updateTriggers: {
      getFillColor: [currentAttr, dataVersion],
      getElevation: [currentAttr, dataVersion]
    }
  });
}

function buildEdificadoLayer() {
  if (!showEdificado) return null;
