/* =========================
   FUNÇÕES DE SIMULAÇÃO
========================= */
function getFinalValues(p) {
  const u = p._userImpact || { IVS:0, IEC:0, IPE:0 };
  const IVS = Math.max(0, Math.min(1, p.IVS + u.IVS));
  const IEC = Math.max(0, Math.min(1, p.IEC + u.IEC));
  const IPE = Math.max(0, Math.min(1, p.IPE + u.IPE));
  const DT = ((1 - IVS) + IEC + IPE) / 3;
  return { IVS, IEC, IPE, DT };
}

function updateAllDTLayers() {
  DT_DATA.features.forEach(f => {
    const p = f.properties;
    const u = p._userImpact || { IVS:0, IEC:0, IPE:0 };
    p.IVS = Math.max(0, Math.min(1, p.IVS + u.IVS));
    p.IEC = Math.max(0, Math.min(1, p.IEC + u.IEC));
    p.IPE = Math.max(0, Math.min(1, p.IPE + u.IPE));
    p.DT_score = ((1 - p.IVS) + p.IEC + p.IPE) / 3;
    p._userImpact = { IVS:0, IEC:0, IPE:0 };
  });
  dataVersion++;
  render();
}

const slider        = document.getElementById("greenSlider");
const label         = document.getElementById("greenValue");
const housingSlider = document.getElementById("housingSlider");
const energySlider  = document.getElementById("energySlider");
const efficiencySlider = document.getElementById("efficiencySlider");

function applySimulations() {
  const dGreen    = slider.value / 100;
  const dHousing  = housingSlider.value / 100;
  const dEnergy   = energySlider.value / 100;
  const dEffic    = efficiencySlider.value / 100;

  label.innerText = slider.value + "%";

  DT_DATA.features.forEach(f => {
    const p = f.properties;
    const b = p._base;

    let IVS = b.IVS;
    let IEC = b.IEC;
    let IPE = b.IPE;

    // Área verde
    IVS = Math.min(1, IVS * (1 + dGreen));
    IEC = Math.max(0, IEC * (1 - dGreen * 0.6));

    // Edificado
    IEC = Math.min(1, IEC * (1 + dHousing * 0.5));
    IPE = Math.min(1, IPE * (1 + dHousing * 0.6));

    // Pressão energética
    IPE = Math.min(1, Math.max(0, IPE * (1 + dEnergy)));
    IEC = Math.min(1, Math.max(0, IEC * (1 + dEnergy * 0.4)));

    // Eficiência urbana
    IEC = Math.max(0, IEC * (1 - dEffic));
    IPE = Math.max(0, IPE * (1 - dEffic));

    // Projeto Entrecampos
    if (projetoAtivo && projetoEntrecamposData.features[0].geometry) {
      IVS = Math.max(0, IVS * 0.85);
      IEC = Math.min(1, IEC * 1.25);
      IPE = Math.min(1, IPE * 1.35);
    }

    // Impacto utilizador
    const u = p._userImpact || { IVS:0, IEC:0, IPE:0 };
    IVS = Math.max(0, Math.min(1, IVS + u.IVS));
    IEC = Math.max(0, Math.min(1, IEC + u.IEC));
    IPE = Math.max(0, Math.min(1, IPE + u.IPE));

    p.IVS = IVS;
    p.IEC = IEC;
    p.IPE = IPE;
    p.DT_score = ((1 - IVS) + IEC + IPE) / 3;
  });

  dataVersion++;
  render();
}

slider.addEventListener("input", applySimulations);
housingSlider.addEventListener("input", applySimulations);
energySlider.addEventListener("input", applySimulations);
efficiencySlider.addEventListener("input", applySimulations);


function applyProjetoImpact() { applySimulations(); }
function resetProjetoImpact() {
  DT_DATA.features.forEach(f => {
    const b = f.properties._base;
