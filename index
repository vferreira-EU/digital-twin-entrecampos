document.getElementById("deck-canvas").addEventListener("click", e => {
  if (!userProjectActive) return;

  const canvas = document.getElementById("deck-canvas");
  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;

  const info = deckgl.pickObject({ x, y, radius: 1 });
  if (info && info.coordinate) {
    pendingUserLonLat = info.coordinate;
  } else {
    const vp = deckgl.getViewports()[0];
    if (vp) {
      pendingUserLonLat = vp.unproject([x, y]);
    }
  }

  if (pendingUserLonLat) {
    document.getElementById("userProjectModal").style.display = "block";
  }
});

function applyUserIntervention(type, lonlat) {
  const def = USER_INTERVENTION_MODEL[type];
  if (!def) return;

  let radius = def.radius || 80;
  if (def.dynamicRadius && type === "building") {
    const area = parseInt(document.getElementById("buildingArea").value) || 1000;
    radius = Math.sqrt(area) * 2;
  }

  userInterventionMarkers.push({ coords: lonlat });
  userProject.interventions.push({ type, latlng: lonlat, radius,
    area: type === "building"
      ? parseInt(document.getElementById("buildingArea").value) || 0
      : 0
  });

  // Raio em graus ~111km/grau
  const radiusDeg = radius / 111000;

  DT_DATA.features.forEach(f => {
    const coords = f.geometry.coordinates[0];
    const cx = (coords[0][0] + coords[2][0]) / 2;
    const cy = (coords[0][1] + coords[2][1]) / 2;
    const dx = cx - lonlat[0];
    const dy = cy - lonlat[1];
    const dist = Math.sqrt(dx*dx + dy*dy);

    if (dist <= radiusDeg) {
      const ui = f.properties._userImpact;
      Object.entries(def.impact).forEach(([k, v]) => {
        ui[k] = (ui[k] || 0) + v;
      });
    }
  });

  applySimulations();
}

document.getElementById("confirmUserProject").addEventListener("click", () => {
  const checked = Array.from(document.querySelectorAll('input[name="userIntervention"]:checked'));
  if (checked.length === 0) {
    alert("Seleciona pelo menos uma intervenção antes de aplicar.");
    return;
  }
  if (pendingUserLonLat) {
    checked.forEach(cb => applyUserIntervention(cb.value, pendingUserLonLat));
  }
  // Limpar checkboxes para a próxima utilização
  document.querySelectorAll('input[name="userIntervention"]').forEach(cb => cb.checked = false);
  pendingUserLonLat = null;
  document.getElementById("userProjectModal").style.display = "none";
});

document.getElementById("cancelUserProject").addEventListener("click", () => {
  document.querySelectorAll('input[name="userIntervention"]').forEach(cb => cb.checked = false);
  pendingUserLonLat = null;
  document.getElementById("userProjectModal").style.display = "none";
});


/* =========================
   CLASSIFICAÇÃO DE VARIAÇÕES
========================= */
function classifyChange(v) {
  if (v > 10) return "forte aumento";
  if (v > 3)  return "aumento moderado";
  if (v > 0)  return "ligeiro aumento";
  if (v < -10) return "forte redução";
  if (v < -3)  return "redução moderada";
  if (v < 0)   return "ligeira redução";
  return "estável";
}

function generateConclusions({ dIVS, dIEC, dIPE, dDT, projetoAtivo, interventions }) {
  let conclusions = [];
  if (dDT > 5) {
    conclusions.push("O cenário simulado conduz a um agravamento global da prioridade de intervenção.");
  } else if (dDT < -5) {
    conclusions.push("O cenário apresenta uma melhoria global das condições urbanas.");
  } else {
    conclusions.push("O cenário mantém um equilíbrio global próximo da situação de referência.");
  }
  if (dIVS > 0 && dIEC < 0) {
    conclusions.push("O reforço de áreas verdes demonstra um efeito mitigador eficaz sobre a exposição ao calor.");
  }
  if (dIPE > 8) {
    conclusions.push("Verifica-se um aumento significativo da pressão energética.");
  }
  if (projetoAtivo) {
    conclusions.push("A presença de um projeto urbanístico estruturante introduz um impacto exógeno relevante.");
  }
  if (interventions.length > 0) {
    conclusions.push("As intervenções localizadas produzem efeitos mitigadores à escala local.");
  }
  return conclusions;
}


/* =========================
   RELATÓRIO
========================= */
function generateSimulationReport() {
  let sumBase = { IVS:0, IEC:0, IPE:0, DT:0 };
  let sumNow  = { IVS:0, IEC:0, IPE:0, DT:0 };
  let count = 0;

  DT_DATA.features.forEach(f => {
    const p = f.properties;
    const b = p._base;
    sumBase.IVS += b.IVS;
    sumBase.IEC += b.IEC;
    sumBase.IPE += b.IPE;
    sumBase.DT  += b.DT_score;
    sumNow.IVS += p.IVS;
    sumNow.IEC += p.IEC;
    sumNow.IPE += p.IPE;
    sumNow.DT  += p.DT_score;
    count++;
  });

  const avg  = v => v / count;
  const diff = (now, base) => base === 0 ? 0 : ((now - base) / base * 100).toFixed(1);

  const dIVS = parseFloat(diff(avg(sumNow.IVS), avg(sumBase.IVS)));
  const dIEC = parseFloat(diff(avg(sumNow.IEC), avg(sumBase.IEC)));
  const dIPE = parseFloat(diff(avg(sumNow.IPE), avg(sumBase.IPE)));
  const dDT  = parseFloat(diff(avg(sumNow.DT),  avg(sumBase.DT)));

  let html = "";

  if (projetoAtivo) {
    html += "<p><b>Projeto ativo:</b> Projeto – Entrecampos</p>";
  }

  html += "<h3>Políticas simuladas</h3><ul>" +
    "<li>Área verde: " + slider.value + "%</li>" +
    "<li>Edificado (fogos): " + (housingSlider.value || 0) + "%</li>" +
    "<li>Pressão energética: " + (energySlider.value || 0) + "%</li>" +
    "<li>Eficiência urbana: " + (efficiencySlider.value || 0) + "%</li>" +
    "</ul>";

  html += "<h3>Impacto médio estimado</h3><ul>" +
    "<li>IVS (Verde & Sombra): " + dIVS + "%</li>" +
    "<li>IEC (Exposição ao Calor): " + dIEC + "%</li>" +
    "<li>IPE (Pressão Energética): " + dIPE + "%</li>" +
    "<li>Índice Composto: " + dDT + "%</li>" +
    "</ul>";

  if (userProject.interventions.length > 0) {
    const html2 = userProject.interventions
      .map(i => `<li><b>${USER_INTERVENTION_LABELS[i.type] || i.type}</b> — raio ${Math.round(i.radius)} m</li>`)
      .join("");
    html += "<h3>Intervenções do Utilizador</h3><ul>" + html2 + "</ul>";
  }

  const conclusions = generateConclusions({ dIVS, dIEC, dIPE, dDT, projetoAtivo, interventions: userProject.interventions });
  html += "<h3>Conclusões do Cenário</h3>";
  conclusions.forEach(c => { html += `<p>${c}</p>`; });

  html += "<p><i>Nota:</i> Os valores representam variações relativas médias face à situação de referência.</p>";

  document.getElementById("reportContent").innerHTML = html;
  document.getElementById("reportModal").style.display = "block";
}

document.getElementById("reportBtn").addEventListener("click", generateSimulationReport);

