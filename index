    f.properties.IEC = b.IEC;
    f.properties.IPE = b.IPE;
    f.properties.DT_score = b.DT_score;
  });
  applySimulations();
}


function resetSimulation() {
  slider.value = 0;
  label.innerText = "0%";
  housingSlider.value = 0;
  energySlider.value  = 0;
  efficiencySlider.value = 0;

  DT_DATA.features.forEach(f => {
    const b = f.properties._base;
    f.properties.IVS = b.IVS;
    f.properties.IEC = b.IEC;
    f.properties.IPE = b.IPE;
    f.properties.DT_score = b.DT_score;
    f.properties._userImpact = { IVS:0, IEC:0, IPE:0 };
  });

  dataVersion++;
  render();
}

