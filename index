========================= */
function scaleValue(attr, f) {
  const p = f.properties;
  const v = attr === "IVS" ? (1 - p.IVS) :
            attr === "IEC" ? p.IEC :
            attr === "IPE" ? p.IPE :
            p.DT_score;
  return Math.max(0, Math.min(1, v));
}

function colorFromValue(v) {
  if (v > 0.8) return [179, 0, 0, 210];
  if (v > 0.6) return [227, 74, 51, 210];
  if (v > 0.4) return [253, 187, 132, 210];
  if (v > 0.2) return [161, 217, 155, 210];
  return [0, 109, 44, 210];
}

/* 5 níveis de altura */
function heightFromValue(v) {
  if (v > 0.8) return 250;
  if (v > 0.6) return 175;
  if (v > 0.4) return 100;
  if (v > 0.2) return 50;
  return 18;
}


